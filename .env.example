APP_URL=http://localhost:3000
POSTGRES_PASSWORD=replace-with-random-password
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
INTERNAL_API_SECRET=replace-with-at-least-32-random-characters
ENCRYPTION_KEY=replace-with-at-least-32-random-characters
DEPLOYMENT_MODE=selfhosted
LIVE_SENDS=false
# Direct OpenAI-compatible endpoint or LiteLLM. No model is imposed on self-hosting.
LLM_BASE_URL=http://litellm:4000/v1
LLM_API_KEY=
LLM_MODEL=
LLM_INPUT_PRICE_PER_MILLION=0
LLM_OUTPUT_PRICE_PER_MILLION=0
AI_CREDITS_PER_DOLLAR=1000
# Enable the optional gateway with: docker compose --profile ai up --build
LITELLM_MODEL=openai/gpt-4.1-mini
OPENAI_API_KEY=
# For OpenRouter: LITELLM_MODEL=openrouter/openai/gpt-6-luna-pro
OPENROUTER_API_KEY=
LITELLM_MASTER_KEY=
# Hosted billing: use Stripe restricted keys with required permissions.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WORKSPACE_PRICE_ID=
STRIPE_ACCOUNT_PRICE_ID=
STRIPE_TOPUP_PRICE_ID=
MONTHLY_AI_CREDITS=0
TOPUP_AI_CREDITS=0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
